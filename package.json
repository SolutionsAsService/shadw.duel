{
  "name": "shadow-duel",
  "version": "1.4.0",
  "description": "A simple original two-player card dueling game.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "test": "node --test tests/*.test.cjs",
    "test:browser": "node tests/browser.cjs",
    "test:text-fit": "node tests/text-fit.cjs",
    "match": "node scripts/bot-match.cjs",
    "art:check": "node scripts/build-card-art.cjs --check"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "express": "^4.19.2",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "playwright": "1.63.0"
  }
}
